{
  "name": "portfolio-system-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "cf dev",
    "build": "tsc --noEmit",
    "build:worker": "cf build",
    "deploy:worker": "cf deploy",
    "types:worker": "cf workers types",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node --import tsx/esm src/db/seed.ts",
    "db:reset": "node --import tsx/esm src/db/reset-schema.ts && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@neondatabase/serverless": "^1.2.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.12.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.16",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.11",
    "cf": "1.0.0-beta.30",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.9"
  }
}
